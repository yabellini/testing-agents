# Slack API Configuration
# Copy this file to .Renviron and fill in your actual values

# Slack Bot Token (required)
# Get this from https://api.slack.com/apps
# Required scopes: channels:read, chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-your-token-here

# Channel where announcements will be posted (optional, defaults to #general)
# Can be channel ID (C01234567) or channel name (#general)
SLACK_ANNOUNCEMENT_CHANNEL=#general
